    <string name="notif_instructions_vivo">Vivo (FunTouch):\n1. Configuración → Notificaciones y barra de estado\n2. %1$s → Permitir notificaciones (ON)</string>
    <string name="notif_instructions_oneplus">OnePlus (OxygenOS):\n1. Configuración → Aplicaciones y notificaciones\n2. %1$s → Notificaciones → Mostrar notificaciones (ON)</string>
